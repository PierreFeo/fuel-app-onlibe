# Prod-настройки для VDS. На сервере: cp .env.prod.example .env.prod и заполнить.
# .env.prod НЕ коммитить! Секреты сгенерировать на сервере командой: openssl rand -hex 32
ENV=prod

# Домен, который смотрит на IP сервера (A-запись). Caddy получит для него HTTPS-сертификат.
DOMAIN=fuel.example.ru

# База. Пароль — только буквы и цифры (openssl rand -hex 24): он попадает в адрес подключения.
POSTGRES_USER=fuel
POSTGRES_PASSWORD=change-me-hex
POSTGRES_DB=fuel
# DATABASE_URL задавать не нужно — docker-compose.prod.yml собирает его из POSTGRES_*

JWT_SECRET=change-me-openssl-rand-hex-32
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=90

OTP_TTL_SEC=300
OTP_PEPPER=change-me-openssl-rand-hex-32

# Кто может войти: номера сотрудников через запятую
REGISTRATION_MODE=whitelist
ALLOWED_PHONES=+79991234567
DEFAULT_PHONE_REGION=RU

SMS_PROVIDER=smsgate
SMSGATE_URL=https://api.sms-gate.app/3rdparty/v1
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
SMSGATE_TIMEOUT_SEC=10
