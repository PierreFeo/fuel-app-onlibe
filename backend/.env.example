# Скопируйте в .env и заполните. .env НЕ коммитить!
ENV=dev

# Контейнер PostgreSQL (docker compose) создаёт пользователя и базу из этих значений
POSTGRES_USER=fuel
POSTGRES_PASSWORD=fuel
POSTGRES_DB=fuel

DATABASE_URL=postgresql+asyncpg://fuel:fuel@db:5432/fuel
TEST_DATABASE_URL=postgresql+asyncpg://fuel:fuel@db:5432/fuel_test

JWT_SECRET=change-me-to-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=90

OTP_TTL_SEC=300
OTP_PEPPER=change-me-too

REGISTRATION_MODE=whitelist
ALLOWED_PHONES=+79991234567
DEFAULT_PHONE_REGION=RU

# Месяцы, когда самый первый лист авто получает зимний сезон (☀️/❄️)
WINTER_MONTHS=11,12,1,2,3

SMS_PROVIDER=console
SMSGATE_URL=https://api.sms-gate.app/3rdparty/v1
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
