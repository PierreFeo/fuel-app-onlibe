# Подпись release-APK. Скопировать в keystore.properties (рядом) и заполнить.
# keystore.properties НЕ коммитить! Сам ключ (.jks) — вне папки проекта, в двух копиях:
# без него обновление не встанет поверх установленного приложения (docs/RELEASE.md).
storeFile=F:/keys/fuel-release.jks
storePassword=change-me
keyAlias=fuel
keyPassword=change-me
