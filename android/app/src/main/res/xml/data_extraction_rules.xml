<?xml version="1.0" encoding="utf-8"?>
<!--
   Резервная копия и перенос на новый телефон (Android 12+).
   Файл DataStore с токенами (di/StorageModule.kt) не копируется — см. backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/fuel_tracker.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/fuel_tracker.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
