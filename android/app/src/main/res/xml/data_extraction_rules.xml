<?xml version="1.0" encoding="utf-8"?>
<!--
   Резервная копия и перенос на новый телефон (Android 12+).
   DataStore и база Room не копируются — см. backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/fuel_tracker.preferences_pb" />
        <exclude domain="database" path="fuel_tracker.db" />
        <exclude domain="database" path="fuel_tracker.db-wal" />
        <exclude domain="database" path="fuel_tracker.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/fuel_tracker.preferences_pb" />
        <exclude domain="database" path="fuel_tracker.db" />
        <exclude domain="database" path="fuel_tracker.db-wal" />
        <exclude domain="database" path="fuel_tracker.db-shm" />
    </device-transfer>
</data-extraction-rules>
